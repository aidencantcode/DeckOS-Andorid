# ignore build dir
build*/

# ignore all dotfiles
./.*

# except these
!.gitignore
!.qmake.conf
!.appveyor.yml
!.circleci/
!.travis/
!.github/

# ignore IDE project files
*.pro.user
*.kdev4
*.workspace

# ignore Qt generated files
*.qmlc
*.jsc
*.autosave

# DECKOS: study-only references and local toolchains never enter the repo
/reference/
/third_party_refs/
/toolchain/

# DECKOS: local Gradle state (IDE tooling) next to the Android build files
src/app/platform/android/.gradle/
