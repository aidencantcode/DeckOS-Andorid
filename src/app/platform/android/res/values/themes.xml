<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PegasusMain">
        <item name="android:colorPrimary">@color/pegasus_bg</item>
        <item name="android:windowBackground">@color/deckos_boot_bg</item> <!-- DECKOS: no grey flash before the boot animation -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>

    <!-- DECKOS: Quick Access overlay - transparent, so the game stays visible beside the panel -->
    <style name="DeckOSOverlay" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
